# Copy to .env.local and fill in. Startup fails with a list of anything missing.

# Postgres connection string (Neon in production; the CI service container in tests).
# Neon URLs (*.neon.tech) use Neon's serverless driver; anything else uses node-postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guitar_shop

# Public origin of the site, used for absolute URLs. Must be https:// in production
# (http://localhost is allowed for local runs).
SITE_URL=http://localhost:3000

# Signs admin session cookies: at least 32 random characters (openssl rand -base64 32).
# Use a different value in each environment, and never commit a real one.
BETTER_AUTH_SECRET=

# Where photos are stored: "fs" keeps them in STORAGE_DIR (default .data/storage) and
# serves public ones at /media; "r2" uses Cloudflare R2 (needed on Vercel).
STORAGE_DRIVER=fs
# STORAGE_DIR=.data/storage

# Cloudflare R2, required when STORAGE_DRIVER=r2. Product photos go in the public bucket,
# served from R2_PUBLIC_URL; repair and sell-form photos go in the private one.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_URL=https://photos.example.com
